{
  "expo": {
    "name": "PlexQo RUN",
    "slug": "plexqo-run",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "plexqo-run",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.plexqo.run",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PlexQo RUN needs your location to track your run distance and route.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PlexQo RUN needs your location to track your run distance and route.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.plexqo.run",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PlexQo RUN needs your location to track your run distance and route.",
          "locationWhenInUsePermission": "PlexQo RUN needs your location to track your run distance and route.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
